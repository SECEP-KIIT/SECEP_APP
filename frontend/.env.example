# Copy to .env.local for local development. Never commit .env files.
# Dev-only flags. Not part of SRS §6.8 and never read by production builds.

# 1 = serve the API from MSW mocks (src/mocks) instead of the backend on :4000.
VITE_MOCK=1

# 1 = keep what you change in the mock (prefs, read state, actions, corrections, projects…) across reloads.
# Versioned: an incompatible saved store is discarded and reseeded. Fake secrets are never saved.
VITE_MOCK_PERSIST=0
